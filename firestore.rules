rules_version = '2';

// Reglas de Firestore para el SkillHouse (skillhouse).
// (Consola de Firebase > Firestore Database > Reglas > pegar y publicar)
//
// Roles:
//   administrador (en la interfaz se llama "administrador") -> crea profesores,
//                     cursos y asigna materias, grados y directores.
//   profesor       -> dicta solo las materias que se le asignaron, en los
//                     cursos de los grados que se le asignaron.
//     tipoProfesor == "director" -> además dirige un curso y crea las cuentas de
//     los estudiantes de ESE curso. Es la única diferencia con un profesor
//     estándar: puede crear estudiantes.
//   estudiante     -> se matricula con el código de una clase de su curso y
//                     juega las clases activas de ese curso sin más código.
//
// El rol interno sigue escribiéndose "administrador" (usuarios/{uid}.rol, la
// colección administradores/ y las rutas de Firebase); solo cambió el nombre
// que ve la gente en pantalla.
//
// Estas reglas están escritas a la par que js/grupos.js, js/cursos.js y
// js/credenciales.js: cada escritura que hace el código tiene su permiso aquí,
// y cada permiso corresponde a una llamada real. Si se cambia una de las dos
// partes, hay que volver a publicar este archivo.

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    // Es administrador si tiene su documento en /administradores.
    function esAdmin() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }

    function docProfesor() {
      return get(/databases/$(database)/documents/profesores/$(request.auth.uid)).data;
    }

    function esProfesor() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/profesores/$(request.auth.uid));
    }

    // Profesor con tipoProfesor == "director": puede crear y ver a los
    // estudiantes del curso que dirige.
    function esDirector() {
      return esProfesor() && docProfesor().tipoProfesor == 'director';
    }

    function docCurso(codigo) {
      return get(/databases/$(database)/documents/cursos/$(codigo)).data;
    }

    // El curso existe y quien escribe es su director. Se admiten las dos formas
    // en que el panel lo registra —que el curso apunte al profesor
    // (cursos.directorUid) o que la ficha del profesor apunte al curso
    // (profesores.curso)— porque el administrador pudo haber asignado solo una
    // de las dos. js/cursos.js:asignarDirector ya las escribe ambas en el mismo
    // lote, así que las dos caras coinciden con lo que ve el cliente.
    function dirigeEseCurso(codigo) {
      return esDirector()
        && codigo != ''
        && exists(/databases/$(database)/documents/cursos/$(codigo))
        && (docCurso(codigo).directorUid == request.auth.uid || docProfesor().curso == codigo);
    }

    function docGrupo(grupoId) {
      return get(/databases/$(database)/documents/grupos/$(grupoId)).data;
    }

    // El grado está escrito en el propio código del curso: 601 es el grado 6 y
    // 1103 es el grado 11, porque los dos últimos dígitos siempre son el grupo
    // (js/cursos.js:codigoDeCurso). Se saca del código y no de un campo, así que
    // funciona igual con los cursos ya creados y con los nuevos. El doble int()
    // deja el grado entero sin importar cómo divida el motor, y un código que no
    // sea numérico hace fallar la conversión: la regla se niega, que es lo mismo
    // que devolvía el viejo 0. Las reglas no aceptan el operador "? :", por eso
    // va en una sola expresión.
    function gradoDelCurso(codigo) {
      return int(int(codigo) / 100);
    }

    // El grado de ese curso está entre los que el administrador le asignó al
    // profesor (o el profesor no tiene grados marcados, que es el caso antiguo:
    // dicta en todo el colegio). Es lo que abre el libro de notas del curso: el
    // profe ve el padrón y las notas de los niños del grado que le toca, y nada
    // más que eso.
    function dictaEseCurso(codigo) {
      return esProfesor()
        && codigo != ''
        && exists(/databases/$(database)/documents/cursos/$(codigo))
        && (!('grados' in docProfesor())
            || docProfesor().grados.size() == 0
            || gradoDelCurso(codigo) in docProfesor().grados);
    }

    function esDuenoDelGrupo(grupoId) {
      return estaAutenticado() && docGrupo(grupoId).profesorId == request.auth.uid;
    }

    function esMiembro(grupoId, uid) {
      return estaAutenticado() && request.auth.uid in docGrupo(grupoId).miembrosUids;
    }

    // El estudiante está matriculado en el curso de esa clase: es lo que hace
    // que un código de 602 no sirva en 601, ahora exigido también en el servidor
    // y no solo en la interfaz.
    function comparteCursoConElGrupo(grupoId, uid) {
      return exists(/databases/$(database)/documents/estudiantes/$(uid))
        && docGrupo(grupoId).curso == get(/databases/$(database)/documents/estudiantes/$(uid)).data.curso;
    }

    // Quién puede estar en una clase: el que ya entró con el código (miembro) o
    // el que es del curso de la clase. Lo segundo es lo que permite el aula
    // estilo Kahoot: el niño no escribe ningún código para jugar, la clase de su
    // curso ya es suya. La lista de miembros sigue existiendo porque es el
    // padrón que el profesor ve en pantalla.
    function puedeParticipar(grupoId, uid) {
      return esMiembro(grupoId, uid) || comparteCursoConElGrupo(grupoId, uid);
    }

    function esEstudiante() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/estudiantes/$(request.auth.uid));
    }

    // El estudiante que entra a una clase de su curso se agrega a sí mismo a la
    // lista: es la única escritura que puede hacer sobre el documento del grupo,
    // no puede quitar a nadie, ni cambiarse el curso, ni tocar el resto de
    // campos.
    function soloSeAgregaASiMismo(grupoId, uid) {
      let cambios = request.resource.data.miembrosUids.diff(resource.data.miembrosUids);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembrosUids'])
        && cambios.removed().size() == 0
        && cambios.added().toSet().difference([uid].toSet()).size() == 0;
    }

    // ------------------- Índice ligero de cada cuenta -------------------

    match /usuarios/{uid} {
      // El admin lista la colección para saber a quién crear y para sus
      // tablas; un usuario normal solo lee su propio documento.
      allow get: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();

      // Un estudiante o profesor puede crearse su índice solo si acaba de
      // registrarse con ese uid. El admin crea el de cualquiera. El director
      // crea únicamente el de sus estudiantes.
      allow create: if estaAutenticado() && (
        (request.auth.uid == uid && request.resource.data.rol in ['estudiante', 'profesor'])
        || esAdmin()
        || (esDirector() && request.resource.data.rol == 'estudiante')
      );

      // Único campo que puede cambiar una vez creada la cuenta: el PIN
      // registrado. El administrador lo cambia al restablecer una clave, y el
      // dueño de la cuenta cuando él mismo se pone una nueva desde su
      // Configuración. Cambiar rol, correo o nombre desde el cliente sería
      // escalar privilegios, y por eso sigue prohibido.
      allow update: if estaAutenticado()
                    && (esAdmin() || request.auth.uid == uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clave']);

      // Borrar cuentas es tarea del administrador, desde su panel de Usuarios.
      // js/credenciales.js:eliminarCuenta firma primero como el interesado (con
      // el PIN que la plataforma le guardó) para borrarlo también de Firebase
      // Auth, y luego viene a quitar este índice.
      allow delete: if esAdmin();
    }

    // ------------------- Estudiantes -------------------

    match /estudiantes/{uid} {
      // El dueño, el administrador, el director que lo matriculó y cualquier
      // profesor al que le asignaron el grado de su curso: este último necesita
      // la ficha para armar el libro de notas del curso (nombre y curso).
      allow get: if estaAutenticado() && (
        request.auth.uid == uid
        || esAdmin()
        || (esDirector() && resource.data.creadoPorUid == request.auth.uid)
        || ('curso' in resource.data && dictaEseCurso(resource.data.curso))
      );
      // El admin lista a todos. Un director solo puede listar filtrando por
      // creadoPorUid: la condición se revalida documento a documento, así
      // que una consulta sin ese filtro devuelve "permission denied" en vez
      // de revelarle los estudiantes de otros directores.
      // El profesor lista el curso que dicta: la misma regla se revalida por
      // documento, así que un "getDocs(estudiantes)" sin filtro de curso sigue
      // estando rechazado.
      allow list: if estaAutenticado() && (
        esAdmin()
        || (esDirector() && resource.data.creadoPorUid == request.auth.uid)
        || ('curso' in resource.data && dictaEseCurso(resource.data.curso))
      );

      // El director solo matricula estudiantes del curso que dirige, y siempre
      // a nombre de nadie más que él (creadoPorUid).
      allow create: if estaAutenticado() && (
        esAdmin()
        || (esDirector()
            && request.resource.data.rol == 'estudiante'
            && request.resource.data.creadoPorUid == request.auth.uid
            && dirigeEseCurso(request.resource.data.curso))
      );

      allow update: if estaAutenticado() && (
        // Personalización del perfil: avatar y color. Nada más.
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar', 'colorFondo']))
        // El "plan b" del curso (js/cursos.js:matricularEnCurso): el propio
        // estudiante escribe el código que le pasó su director, pero solo para
        // RELLENAR un curso vacío. Si pudiera moverse entre dos cursos que ya
        // existen, bastaría con que se sepa el código de 602 para meterse en las
        // clases de otro grado. Y el curso tiene que existir de verdad.
        || (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['curso'])
          && (!('curso' in resource.data) || resource.data.curso == '')
          && exists(/databases/$(database)/documents/cursos/$(request.resource.data.curso)))
        // El administrador sí corrige un curso mal puesto: es el único que ve
        // el padrón completo y desde su panel de Usuarios hace el cambio.
        || (esAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['curso']))
      );
      allow delete: if esAdmin();

      // Historial personal de partidas (copia de grupos/*/resultados).
      match /resultados/{resultadoId} {
        // El admin también las lee: es la única forma de borrarlas junto con la
        // cuenta (js/credenciales.js:eliminarCuenta), y ya es el único que puede
        // ver el historial de un estudiante desde Reportes.
        allow read: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
        allow create: if estaAutenticado() && request.auth.uid == uid
                      && request.resource.data.uid == uid;
        // Al borrar la cuenta se va su historial: es el derecho de petición de
        // datos de un menor (Ley 1581 de 2012), y Firestore no borra
        // subdocumentos en cascada.
        allow delete: if esAdmin();
        allow update: if false;
      }
    }

    // ------------------- Profesores -------------------

    match /profesores/{uid} {
      allow get: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
      // El admin lista los profesores para sus informes y para elegir el
      // director de un curso.
      allow list: if esAdmin();

      allow create: if esAdmin();

      // El dueño solo se personaliza el avatar. El administrador corrige el
      // alta: qué materia dicta, si es director y de qué curso. Esos tres
      // campos son los que escribe interfaz-administrador/cursos.js al mover
      // un director; sin este permiso el cambio quedaba a medias y el profesor
      // seguía viendo el curso viejo.
      allow update: if estaAutenticado() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar', 'colorFondo']))
        || (esAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['curso', 'materias', 'tipoProfesor', 'grados']))
      );
      // Borrar a un profesor se hace desde el panel del administrador; eso
      // arrastra sus clases, que se eliminan en el mismo lote (grupos/).
      allow delete: if esAdmin();
    }

    match /administradores/{uid} {
      allow read, write: if esAdmin();
    }

    // ------------------- Cursos -------------------

    match /cursos/{codigo} {
      // Cualquier usuario autenticado necesita la lista de cursos: el
      // profesor al crear una clase y el estudiante para saber a cuál
      // pertenece. Un curso solo expone código, nombre, año y director.
      allow read: if estaAutenticado();

      // Solo el administrador da de alta y baja cursos.
      allow create, update, delete: if esAdmin();
    }

    // ------------------- Clases (grupos) -------------------

    // Un profesor crea una clase para un curso y una materia; los
    // estudiantes se unen con el código y juegan.
    //
    // Nota de seguridad: para poder "unirse por código" sin conocer antes el
    // ID del documento, la lectura de grupos está abierta a cualquier usuario
    // autenticado. Es un dato de aula (nombre de la clase, código, lista de
    // miembros), no información personal sensible, y cerrarla al dueño rompería
    // tanto el ingreso por código como la comprobación de código libre.
    // Lo que sí se estrecha son las escrituras y los subdocumentos.
    match /grupos/{grupoId} {
      allow read: if estaAutenticado();

      allow create: if esProfesor()
        && request.resource.data.profesorId == request.auth.uid
        && request.resource.data.miembrosUids == []
        // Solo materias que tiene asignadas: un profesor de Inglés no puede
        // abrir una clase de Matemáticas.
        && request.resource.data.materia in docProfesor().materias
        // Debe indicar un curso que existe de verdad.
        && request.resource.data.curso is string
        && request.resource.data.curso != ''
        && exists(/databases/$(database)/documents/cursos/$(request.resource.data.curso))
        // El administrador le asignó grados (profesores.grados): solo puede
        // abrir clases en cursos de esos grados. Sin `grados` —cuentas creadas
        // antes de este cambio, o un profesor al que el administrador todavía no
        // le marca grados— puede usar cualquier curso, que es como funcionaba.
        // El director de curso perdió su restricción de un solo curso: ahora
        // dirige uno pero dicta su materia en los demás grados que le asignen.
        && (!('grados' in docProfesor())
            || docProfesor().grados.size() == 0
            || gradoDelCurso(request.resource.data.curso) in docProfesor().grados);

      // Solo el profesor dueño puede modificar o borrar su clase. El
      // administrador también: al borrar una cuenta hay que sacarla de
      // `miembrosUids` de las clases ajenas y llevarse por completo las clases
      // del profesor que se va (js/credenciales.js:eliminarCuenta).
      // El estudiante tiene un caso aparte y angostísimo: agregarse a sí mismo
      // a la lista de una clase de su curso (soloSeAgregaASiMismo).
      allow update: if esDuenoDelGrupo(grupoId)
                    || esAdmin()
                    || (esEstudiante()
                        && soloSeAgregaASiMismo(grupoId, request.auth.uid)
                        && comparteCursoConElGrupo(grupoId, request.auth.uid));
      allow delete: if esDuenoDelGrupo(grupoId) || esAdmin();

      // Ficha del estudiante dentro de la clase. La escribe el profesor dueño o
      // el propio alumno cuando entra a una clase de su curso; el alumno también
      // puede sacarse de ella.
      //
      // setDoc() sobre un miembro que ya existe cuenta como UPDATE, no como
      // create, así que el permiso tiene que cubrir los dos: con
      // "allow update: if false" volver a entrar a una clase donde ya estaba
      // devolvía permission-denied y dejaba la lista a medias
      // (miembrosUids actualizado, ficha sin escribir).
      match /miembros/{uid} {
        allow get, list: if esDuenoDelGrupo(grupoId) || esAdmin();
        allow create, update: if esDuenoDelGrupo(grupoId)
          || (esEstudiante() && request.auth.uid == uid && puedeParticipar(grupoId, uid));
        allow delete: if esDuenoDelGrupo(grupoId) || esAdmin() || request.auth.uid == uid;
      }

      // Presencia en la sala de espera (js/sala.js). Un documento por
      // estudiante, no un arreglo en el grupo: si los 30 niños escribieran en
      // `grupos/{id}` pelearían por el mismo documento, y Firestore aguanta
      // alrededor de una escritura por segundo ahí.
      //
      // La lista es visible para el dueño, el admin y los compañeros de clase:
      // la pantalla de espera tiene que mostrar quién ya llegó, que es justo el
      // objetivo del modo Kahoot. No expone correos ni PINes, solo el nombre.
      match /sala/{uid} {
        allow get, list: if estaAutenticado()
          && (esDuenoDelGrupo(grupoId) || esAdmin() || puedeParticipar(grupoId, uid));

        // Solo uno anota su propia asistencia, solo si puede estar en la clase
        // y solo mientras la clase siga activa.
        allow create, update: if estaAutenticado() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && puedeParticipar(grupoId, uid)
          && docGrupo(grupoId).activo == true;

        // El profesor vacía la sala entre sesiones; el estudiante puede borrar
        // su propio cartel; el administrador limpia la presencia de una cuenta
        // que se borra.
        allow delete: if esDuenoDelGrupo(grupoId) || esAdmin() || request.auth.uid == uid;
      }

      match /resultados/{resultadoId} {
        allow get: if esDuenoDelGrupo(grupoId) || esAdmin()
                   || (estaAutenticado() && resource.data.uid == request.auth.uid);
        allow list: if esDuenoDelGrupo(grupoId) || esAdmin()
                    || (estaAutenticado() && puedeParticipar(grupoId, request.auth.uid));
        // Antes bastaba con conocer el ID de una clase para meterle resultados
        // falsos desde la consola: la pertenencia se comprobaba solo en el
        // cliente. Ahora también aquí, y el código sigue comprobándola para dar
        // un mensaje claro.
        allow create: if estaAutenticado()
          && request.resource.data.uid == request.auth.uid
          && puedeParticipar(grupoId, request.auth.uid);
        allow update: if false;
        // Las notas de una cuenta que se borra se borran con ella (petición de
        // datos de menor, Ley 1581 de 2012).
        allow delete: if esAdmin();
      }
    }

    // ------------------- Sugerencias de "Ayuda" -------------------

    match /sugerencias/{id} {
      // Cualquiera puede opinar, incluso sin cuenta (los invitados), pero solo
      // con la forma real que escribe js/ayuda.js y con el texto acotado: sin
      // límite, un único visitante podía llenar la colección.
      allow create: if request.resource.data.keys().hasOnly(['mensaje', 'nombre', 'atendida', 'fecha'])
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() > 0
                    && request.resource.data.mensaje.size() <= 1000
                    && request.resource.data.atendida == false;
      allow read: if esAdmin();
      // El admin solo marca la sugerencia como atendida; no reescribe el
      // texto de quien opinó.
      allow update: if esAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['atendida']);
      allow delete: if false;
    }

    // ------------------- Solicitudes de cambio de contraseña -------------------

    // Las abre estudiante, profesor o director cuando no recuerdan su PIN.
    // Nadie escribe ahí una contraseña: es un pedido, y el administrador lo
    // resuelve desde su panel de Claves.
    match /solicitudes_clave/{id} {
      allow get: if estaAutenticado() && (esAdmin() || resource.data.uid == request.auth.uid);
      allow list: if estaAutenticado() && (esAdmin() || resource.data.uid == request.auth.uid);

      // Campos fijos y motivo acotado: un pedido no puede llevar datos ajenos
      // (una clave, por ejemplo) ni ocupar la base de datos a texto libre.
      allow create: if estaAutenticado()
                    && request.resource.data.keys().hasOnly(['uid', 'nombre', 'email', 'rol', 'motivo', 'estado', 'creadoEn'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.motivo is string
                    && request.resource.data.motivo.size() <= 300;

      // El administrador solo mueve el estado; el texto del pedido no se reescribe.
      allow update: if esAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'resueltaEn']);
      // Al borrarse una cuenta se van también sus pedidos pendientes.
      allow delete: if esAdmin();
    }
  }
}
