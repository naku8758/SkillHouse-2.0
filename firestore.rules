rules_version = '2';

// Reglas recomendadas para Firestore (Consola Firebase > Firestore Database > Reglas).
// Permiten que cada usuario autenticado cree/lea SU PROPIO documento
// (necesario para el registro y para validar el rol al iniciar sesión),
// pero nadie puede leer ni modificar los datos de otros usuarios.

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    match /estudiantes/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    match /profesores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    match /administradores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // Grupos de juego: un profesor crea un grupo (elige un juego y obtiene
    // un código); los estudiantes se unen con ese código y juegan.
    // Nota de seguridad: para que un estudiante pueda "unirse por código"
    // sin conocer antes el ID del grupo, la lectura se deja abierta a
    // cualquier usuario autenticado (adecuado para una herramienta de aula
    // de bajo riesgo; no se exponen datos personales sensibles). Las
    // escrituras sí quedan restringidas al dueño del grupo o al propio
    // estudiante que se une.
    match /grupos/{grupoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.profesorId == request.auth.uid
                    && request.resource.data.miembrosUids == [];
      allow update: if request.auth != null && (
        // El profesor dueño puede modificar cualquier campo (activar/desactivar, etc.)
        resource.data.profesorId == request.auth.uid
        ||
        // Un estudiante solo puede agregarse a sí mismo a miembrosUids
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembrosUids'])
          && request.resource.data.miembrosUids == resource.data.miembrosUids.concat([request.auth.uid])
        )
      );
      allow delete: if request.auth != null && resource.data.profesorId == request.auth.uid;

      match /miembros/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }

      match /resultados/{resultadoId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/grupos/$(grupoId)).data.profesorId == request.auth.uid
          || resource.data.uid == request.auth.uid
        );
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
